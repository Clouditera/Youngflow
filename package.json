{
  "name": "youngflow",
  "version": "0.8.3",
  "description": "Generic AI flow runner — LangGraph orchestration + pi CLI execution",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "youngflow": "bin/youngflow.js"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.js",
    "dev": "tsc --watch",
    "start": "node bin/youngflow.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "bundle": "node scripts/bundle.js",
    "build:binary": "npm run build && npm run bundle && node scripts/build-binaries.js"
  },
  "dependencies": {
    "@langchain/langgraph": "^0.2",
    "ajv": "^8.17",
    "commander": "^13.0",
    "fast-glob": "^3.3",
    "js-yaml": "^4.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0",
    "@types/node": "^22.0",
    "@yao-pkg/pkg": "^6.19.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.7",
    "vitest": "^4.1.4"
  },
  "pkg": {
    "assets": [
      "flow.schema.yaml",
      "package.json"
    ],
    "targets": [
      "node20-linux-x64",
      "node20-macos-x64",
      "node20-macos-arm64",
      "node20-win-x64"
    ],
    "outputPath": "release"
  },
  "engines": {
    "node": ">=20"
  }
}
