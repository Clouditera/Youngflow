# YoungFlow 运行配置
# 复制为 .env 并填入你的配置
# 不配置则使用用户本地的 pi 凭证

# ── 模型协议类型 ──
# openai    - OpenAI 兼容协议（适用于 OpenAI、OpenRouter、OneAPI、各类中转平台）
# anthropic - Anthropic 原生协议（适用于直连 Anthropic 或 Anthropic 协议的代理）
MODEL_PROTO_TYPE=anthropic

# ── 模型名称 ──
LLM_MODEL_NAME=claude-sonnet-4-5

# ── 自定义端点（可选）──
# 留空则直连官方 API
# 填入中转/代理平台地址，如：
#   https://my-oneapi.example.com/v1
#   https://openrouter.ai/api/v1
LLM_BASE_URL=

# ── API Key ──
LLM_API_KEY=

# ── 推理深度 ──
# off / minimal / low / medium / high / xhigh
MODEL_EFFORT=high

# ── 空响应重试 ──
# 模型 API 偶尔返回空响应，引擎会自动恢复会话重试
# YOUNGFLOW_EMPTY_RETRIES: 重试次数（默认 2，即最多 3 次尝试）
# YOUNGFLOW_EMPTY_RETRY_BACKOFF: 退避基数秒（默认 3，指数增长: 3s→6s→12s）
# YOUNGFLOW_EMPTY_RETRIES=2
# YOUNGFLOW_EMPTY_RETRY_BACKOFF=3
